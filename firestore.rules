rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 학교 설정 공유본 — 읽기는 누구나(교사 전원), 쓰기는 관리자 계정만.
    // 관리자 판별은 로그인 계정의 이메일로 한다. 명단을 늘리려면 여기에 줄을 더한다.
    match /school/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['dunaro.gogo@gmail.com', 'hae@mil.com'];
    }
    // 그 밖의 모든 문서는 잠근다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
