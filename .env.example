# ── AI 문안 (선택) ─────────────────────────────────────────
# OpenRouter — 서버 라우트(/api/generate)에서만 읽는다. 클라이언트로 나가지 않는다.
# 비워 두면 결정적 대체 문구(fallback)로 동작한다.
# ★ 이름에 NEXT_PUBLIC_ 을 붙이지 말 것 — 붙이면 클라이언트 번들에 그대로 심긴다.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
OPENROUTER_SITE_URL="http://localhost:3000"

# ── 로그인 (Firebase · 구글 계정) ───────────────────────────
# 넷 다 채우면 로그인이 켜진다. 비워 두면 잠그지 않으므로 로컬 개발이 편하다.
#
# NEXT_PUBLIC_* 은 브라우저로 나간다. 비밀이 아니다 — '어느 프로젝트냐'를 가리키는 주소다.
#   Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) 에서 그대로 복사.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# ★ 이건 진짜 비밀이다. 새면 프로젝트가 통째로 열린다.
#   Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → '새 비공개 키 생성'으로 받은
#   JSON 파일 **내용 전체**를 한 줄로 붙여넣는다(줄바꿈 없이).
FIREBASE_SERVICE_ACCOUNT=""

# 관리자 명단 — 쉼표로 나열. 여기 적힌 사람은 승인 없이 바로 관리자이고,
# 앱 안 '관리자 → 사용자 승인'에서 남을 승인해 줄 수 있다.
# 데이터베이스에만 두면 첫 관리자를 만들 길이 없어서 설정값으로 둔다.
ADMIN_EMAILS=""
