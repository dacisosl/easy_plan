# SQLite 파일 경로
DATABASE_URL="file:./dev.db"

# OpenRouter — 서버 라우트(/api/generate)에서만 읽는다. 클라이언트로 나가지 않는다.
# 비워 두면 결정적 대체 문구(fallback)로 동작한다.
# ★ 이름에 NEXT_PUBLIC_ 을 붙이지 말 것 — 붙이면 클라이언트 번들에 그대로 심긴다.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
OPENROUTER_SITE_URL="http://localhost:3000"

# 접근 비밀번호 — 공개 배포할 때만 채운다.
# 채우면 페이지와 API 전체가 HTTP Basic 인증으로 잠긴다 (아이디는 아무거나).
# 비워 두면 잠그지 않는다. 로컬 개발에서는 비워 두면 된다.
APP_PASSWORD=""
